{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "**/.output/**",
    "**/migrations/**"
  ]
}
