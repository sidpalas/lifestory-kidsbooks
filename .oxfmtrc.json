{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/styles.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "apps/web/src/routeTree.gen.ts",
    "packages/db/migrations/**",
    "fixtures/stories/**"
  ],
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
