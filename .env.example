# Copy to .env (.agents/setup does this). Every process reads it: the web app,
# the worker, migrations, the seed script, and Playwright.

# Postgres (compose.yaml). Holds app data, Better Auth tables, and Absurd queues.
DATABASE_URL=postgres://lifestory:lifestory@localhost:5432/lifestory

# S3-compatible object storage (SeaweedFS in compose.yaml; any S3 API in production).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=lifestory
S3_ACCESS_KEY_ID=lifestory
S3_SECRET_ACCESS_KEY=lifestory-secret
# Path-style URLs (default true, for SeaweedFS). Set false for providers that require
# virtual-hosted-style URLs, such as Railway buckets.
# S3_FORCE_PATH_STYLE=true

# Better Auth. Generate a real secret for any shared deployment: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# The app's public origin. Leave it unset locally: `mise run dev:web` derives it
# from $PUBLIC_URL (Amp portals) or $PORT. mise loads this file over the process
# environment, so a value here would override those.
# BETTER_AUTH_URL=http://localhost:3000

# The web app's origin as the worker reaches it: headless Chromium on the worker opens print pages there to make
# PDF proofs. Defaults to http://localhost:3000.
# PRINT_APP_URL=http://localhost:3000

# Enables /__dev/log-me-in. Never set in production.
DEV_LOGIN_ENABLED=true

# Email delivery: "log" (the default; D23) writes each invitation and set-password link to the web server's log
# instead of sending it. "resend" sends it with Resend (D39) and needs the two variables below.
# EMAIL_PROVIDER=log
# RESEND_API_KEY=re_...
# An address on a domain verified in Resend.
# EMAIL_FROM=Lifestory <hello@mail.example.com>

# Image generation provider: "fake" (the default; deterministic placeholders, needs nothing else) or "openai"
# (D56: character sheets and figures drawn from families' photos). Don't run it unless asked: every edit is billed.
# IMAGE_PROVIDER=fake
# With IMAGE_PROVIDER=openai, or PHOTO_CHECK=openai.
# OPENAI_API_KEY=
# A model OpenAI lists as eligible for zero data retention.
# OPENAI_PHOTO_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=medium
# What the OpenAI project keeps of what we send: "standard" (the default; OpenAI keeps it up to 30 days for abuse
# monitoring) or "zero" (zero data retention, only once the project has it). It blocks nothing: the policies, consent
# and landing page describe the retention it states (D56).
# OPENAI_DATA_RETENTION=standard
# The photo check (D56): "fake" (the default; refuses a photo whose file name contains "two-faces") or "openai"
# (omni-moderation-latest, then OPENAI_CHECK_MODEL).
# PHOTO_CHECK=fake
# OPENAI_CHECK_MODEL=gpt-5.4-mini
# Preview change rounds: "edit" (the default; each note edits the current sheet) or "fresh" (a new sheet from the photo).
# LIKENESS_REVISE_MODE=edit
